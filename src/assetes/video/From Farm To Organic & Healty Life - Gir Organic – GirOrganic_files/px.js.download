    document.addEventListener('mouseout',function(e){
      if(e.clientY<=0&&!e.relatedTarget&&eligible())fire();});
    if('ontouchstart' in window){setInterval(function(){
      var c=g('mmpop_cart');if(c&&Date.now()-c>20000&&eligible())fire();},5000);}
  })();
  // ─── hidden visitor-id field ───────────────────────────────────────────────
  // Spliced from id-field-fill.template.js, the same text mm-tracking.js
  // gets: puts MM into a CRM form's hidden visitor-id field (a LeadSquared
  // form's mx_Cookiebees_Visitor_Id) and touches nothing else on the page.
/**
 * FILL A CRM FORM'S HIDDEN VISITOR-ID FIELD - one source, spliced into both
 * beacons (mm-tracking.js for lead sites, px.js for stores), the same way the
 * tag observer is.
 *
 * WHY. A lead captured by ANOTHER system's form on the tenant's site (a
 * LeadSquared embedded form today) reaches Cookiebees through that CRM, and
 * the CRM knows nothing about the visit: no click id, no _fbp, no UTMs. Ad
 * platforms cannot match a conversion without those. If that form carries a
 * hidden field for our visitor id, the CRM stores the id with the lead, sends
 * it back to us, and services/leadsquared.js joins the lead to the visit
 * through identityCookies.forLead. This script's only job is to put the id in
 * that field.
 *
 * WHAT IT TOUCHES, AND WHAT IT REFUSES TO.
 *   - Only <input> elements whose name, id or data-schemaname is EXACTLY one
 *     of the names below (case-insensitive), or that carry
 *     data-cookiebees="visitor_id". Nothing else on the page is read or
 *     written. A tenant with a different column name adds it to the install
 *     tag: data-mm-id-field="mx_My_Field" (comma-separated for several).
 *   - Only an EMPTY field, or one already holding a visitor id of ours. A
 *     value somebody typed is never overwritten.
 *   - It never submits, never reads other fields, never posts anything.
 *
 * WHEN. On load, on DOM changes for the first 60 seconds (LeadSquared renders
 * its form after the page), and on focus and submit of any form (catches a
 * form opened later in a popup). All three are cheap: one querySelectorAll
 * over a short selector.
 *
 * React-controlled inputs ignore a plain `.value =`, so the value is set
 * through the native setter and an input + change event is dispatched, which
 * is what those forms listen for.
 *
 * The host provides H.id() (the durable visitor id) and H.names (extra field
 * names from the install tag). Start it with MM_FILL_ID_FIELDS(H).
 */
function MM_FILL_ID_FIELDS(H) {
  try {
    var NAMES = ['mx_Cookiebees_Visitor_Id', 'cookiebees_visitor_id', 'cb_visitor_id'];
    var extra = H && H.names ? String(H.names).split(',') : [];
    for (var i = 0; i < extra.length; i++) {
      var n = String(extra[i] || '').replace(/[^A-Za-z0-9_-]/g, '');
      if (n) NAMES.push(n);
    }
    var LOWER = {};
    for (var j = 0; j < NAMES.length; j++) LOWER[NAMES[j].toLowerCase()] = 1;
    var OURS = /^(IMP[A-Za-z0-9]{4,}|mmc_[A-Za-z0-9]{4,})$/;
    var setter = null;
    try { setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; } catch (_) {}

    function wanted(el) {
      if (!el || el.tagName !== 'INPUT') return false;
      if ((el.getAttribute('data-cookiebees') || '').toLowerCase() === 'visitor_id') return true;
      var keys = [el.getAttribute('name'), el.id, el.getAttribute('data-schemaname'), el.getAttribute('data-schema-name')];
      for (var k = 0; k < keys.length; k++) if (keys[k] && LOWER[String(keys[k]).toLowerCase()]) return true;
      return false;
    }
    function put(el, id) {
      var cur = el.value || '';
      if (cur === id) return;
      if (cur && !OURS.test(cur)) return;           // someone else's value: leave it
      try { if (setter) setter.call(el, id); else el.value = id; } catch (_) { el.value = id; }
      try { el.setAttribute('value', id); } catch (_) {}
      try {
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
      } catch (_) {}
    }
    function fill(root) {
      var id = '';
      try { id = H.id(); } catch (_) { return; }
      if (!id) return;
      var scope = root && root.querySelectorAll ? root : document;
      var list = scope.querySelectorAll('input');
      for (var x = 0; x < list.length; x++) if (wanted(list[x])) put(list[x], id);
    }

    fill(document);
    document.addEventListener('focusin', function (e) {
      try { var f = e.target && e.target.form; if (f) fill(f); } catch (_) {}
    }, true);
    document.addEventListener('submit', function (e) {
      try { if (e.target) fill(e.target); } catch (_) {}
    }, true);
    if (typeof MutationObserver === 'function') {
      var pending = false;
      var mo = new MutationObserver(function () {
        if (pending) return;
        pending = true;
        setTimeout(function () { pending = false; fill(document); }, 250);
      });
      mo.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(function () { try { mo.disconnect(); } catch (_) {} }, 60000);
    }
  } catch (_) { /* never break the host page */ }
}

  try{MM_FILL_ID_FIELDS({id:function(){return MM;},names:null});}catch(e){}
  // ─── call tracking number swap ─────────────────────────────────────────────
  // Spliced from call-swap.template.js, the same text mm-tracking.js gets.
  /**
   * CALL TRACKING NUMBER SWAP - one source, spliced into both beacons
   * (mm-tracking.js for lead sites, px.js for stores), like the tag observer.
   *
   * WHAT IT DOES. On a page that shows a phone number, asks which tracked
   * number this visitor session should see (services/callTracking.numberFor)
   * and puts it in place of the site's own number, so a call can be tied back
   * to the visit: its source, campaign and click ids.
   *
   * WHAT IT TOUCHES, AND NOTHING ELSE.
   *   - <a href="tel:..."> links whose number is one of the site numbers the
   *     workspace listed (all tel: links when none are listed): the href, and
   *     the link text when the text IS that number.
   *   - Any element marked data-cb-call: its text (and href, on a link).
   *     data-cb-call="href" changes the link only, never the text.
   * A page with no phone link and no marked element sends nothing at all.
   * A workspace without call tracking answers { swap: false } and nothing
   * changes. Any failure leaves the site's own number showing.
   */
  function MM_CALL_SWAP(o) {
    try {
      if (!o || !o.key || !o.base || !document.querySelectorAll) return;
      var SEL = 'a[href^="tel:"],[data-cb-call]';
      var CACHE = 'cb_cn';
      var answer = null;
      var asked = false;
      var d10 = function (s) { return String(s || '').replace(/\D/g, '').slice(-10); };
      var list = function () { try { return document.querySelectorAll(SEL); } catch (e) { return []; } };

      var apply = function (a) {
        if (!a || !a.swap || !a.number) return;
        var targets = a.targets || [];
        var els = list();
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          try {
            var mark = el.getAttribute('data-cb-call');
            if (mark !== null) {
              if (el.tagName === 'A') el.setAttribute('href', 'tel:' + a.number);
              // Only when it differs: writing text is itself a DOM change, and
              // the observer below would otherwise answer it for ever.
              if (mark !== 'href' && !el.children.length && el.textContent !== (a.display || a.number)) el.textContent = a.display || a.number;
              continue;
            }
            var href = el.getAttribute('href') || '';
            var cur = d10(href);
            if (!cur || cur === d10(a.number)) continue;
            if (targets.length && targets.indexOf(cur) === -1) continue;
            el.setAttribute('href', 'tel:' + a.number);
            if (!el.children.length && d10(el.textContent) === cur) el.textContent = a.display || a.number;
          } catch (e) { /* one odd element never stops the rest */ }
        }
      };

      var ask = function () {
        if (asked || !list().length) return false;
        asked = true;
        var sid = '';
        try { sid = o.sid ? o.sid() : ''; } catch (e) {}
        // The number this session already has, shown at once so the page does
        // not flick from one number to another; the request below renews it.
        try {
          var c = JSON.parse(sessionStorage.getItem(CACHE) || 'null');
          if (c && c.sid === sid && c.exp > Date.now()) { answer = c.a; apply(answer); }
        } catch (e) {}
        var attrs = {};
        try { attrs = o.data ? (o.data() || {}) : {}; } catch (e) {}
        var body = JSON.stringify({ id: o.id ? o.id() : null, sid: sid, a: attrs });
        try {
          fetch(o.base + '/cn/' + encodeURIComponent(o.key), {
            method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: body, keepalive: true, credentials: 'omit'
          }).then(function (r) { return r.json(); }).then(function (a) {
            answer = a;
            try { sessionStorage.setItem(CACHE, JSON.stringify({ sid: sid, a: a, exp: Date.now() + 10 * 60000 })); } catch (e) {}
            apply(a);
          }).catch(function () {});
        } catch (e) {}
        return true;
      };

      // Now, or as soon as a phone number appears (themes and page builders
      // render late), and on links added afterwards, for the first minute.
      if (!ask() && document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { ask(); });
      }
      if (window.MutationObserver) {
        var mo = new MutationObserver(function () { if (!ask() && answer) apply(answer); });
        mo.observe(document.documentElement, { childList: true, subtree: true });
        setTimeout(function () { try { mo.disconnect(); } catch (e) {} }, 60000);
      }
    } catch (e) { /* the swap must never take the beacon down with it */ }
  }

  try{MM_CALL_SWAP({key:K,base:T,id:function(){return MM;},sid:sid,data:track});}catch(e){}

  // ─── the tag observer ─────────────────────────────────────────────────────
  // Spliced from tag-observer.template.js, the same text mm-tracking.js gets,
  // so the vendor list this store is judged against is the vendor list every
  // other store is judged against. Wrapped because a monitor that throws must
  // never take the beacon - and with it the store's own attribution - down.
/**
 * THE TAG OBSERVER - one source, spliced into whichever beacon is on the page.
 *
 * This used to live inside mm-tracking.js, which is the LEAD beacon. Every
 * ecommerce workspace loads px.js instead, so the monitor was unreachable on
 * exactly the stores it was built for: GirOrganic and WeightWorld could not
 * have switched it on if they had wanted to. Copying it into px.js would have
 * meant two vendor lists drifting apart within a month, which is the failure
 * this product exists to detect, so instead there is one file and both hosts
 * splice it in at render time. No extra request: it is inlined, not fetched.
 *
 * The host provides four things through `H`, because each beacon already has
 * its own spelling of them and neither should have to change:
 *   H.key   the workspace tracking key
 *   H.base  the /api/track base, first-party where the workspace has one
 *   H.id()  the durable visitor id
 *   H.sid() the session id - the join the whole timeline hangs off
 *   H.send(url, body) a keepalive POST that survives the page unloading
 *
 * Everything below is unchanged from where it was first written, including the
 * reasoning. Start the observer with `MM_OBSERVER(H)`, and hand anything it
 * throws to `MM_OBSERVER_FAILED(H, err)` rather than to an empty catch.
 */
function MM_OBSERVER(H) {
  // Checked up front, so a host that forgot one fails HERE with a sentence,
  // not three frames down as "cannot read properties of undefined". The lead
  // beacon once passed a variable that did not exist at the call site; the
  // ReferenceError was caught by an empty catch and the monitor never started
  // on any lead site, with nothing anywhere to say so.
  if (!H || typeof H !== 'object') throw new Error('the tag monitor was started without its host settings');
  if (!H.key) throw new Error('no tracking key on the page, so there is nowhere to send what the monitor sees');
  if (!H.base) throw new Error('no address to send tag events to');
  if (typeof H.id !== 'function' || typeof H.sid !== 'function' || typeof H.send !== 'function') {
    throw new Error('the tag monitor host is missing id, sid or send');
  }
  /* ── The tag observer ──────────────────────────────────────────────────────
   *
   * WHY THIS LIVES HERE AND NOT IN GTM.
   *
   * A monitor loaded through GTM cannot see GTM being the thing that broke -
   * it is the smoke alarm wired to the candle. This script is already served
   * first-party from the tenant's own domain on a random path, so it survives
   * the ad-blockers, consent tools and bad container publishes that take the
   * tags themselves out. That is the whole reason to observe from here.
   *
   * WHAT IT RECORDS, AND WHAT IT REFUSES TO.
   *
   * Vendor, event name, outcome, latency, the order id the tag was carrying,
   * and the consent state at that instant. Never the request body. We answer
   * "did your Meta pixel report this order, and was it allowed to?" - not
   * "what was in it", which is the tenant's data and their vendor's business.
   *
   * HOW THE OUTCOME IS KNOWN. Cross-origin resource timing gives us little:
   * `responseStatus` where the browser offers it, otherwise a transferSize of
   * zero with no duration is the signature of a request that never left. So
   * the vocabulary is deliberately coarse - fired / blocked / no_response -
   * and never claims an HTTP status the browser did not give us.
   */
  var VENDORS = [
    // host fragment            vendor        how the event is named on the wire
    ['facebook.com/tr',         'meta',       function (u) { return u.searchParams.get('ev'); }],
    ['/g/collect',              'ga4',        function (u) { return u.searchParams.get('en'); }],
    ['google-analytics.com/collect', 'ga4',   function (u) { return u.searchParams.get('t'); }],
    // A GOOGLE ADS HIT IS NOT A CONVERSION JUST BECAUSE GOOGLE ADS SENT IT.
    //
    // Both of these were labelled 'conversion', and the remarketing tag fires
    // on every page a visitor opens - so 46 of the first 46 fires recorded on a
    // live store were product, login and search pages calling themselves
    // conversions. The reconciliation falls back to matching on the session, so
    // every order would have matched one of them and Google Ads coverage would
    // have read 100% whether the conversion tag ever fired or not.
    //
    // The path is what separates them: /pagead/viewthroughconversion/ is
    // remarketing, /pagead/conversion/ is the conversion tag.
    ['googleads.g.doubleclick.net', 'google_ads', function (u) {
      return /viewthroughconversion/i.test(u.pathname) ? 'remarketing' : 'conversion';
    }],
    ['googleadservices.com/pagead/conversion', 'google_ads', function () { return 'conversion'; }],
    ['analytics.tiktok.com',    'tiktok',     function (u) { return u.searchParams.get('event'); }],
    ['px.ads.linkedin.com',     'linkedin',   function () { return 'conversion'; }],
    ['ct.pinterest.com',        'pinterest',  function (u) { return u.searchParams.get('event'); }],
    ['bat.bing.com',            'bing',       function (u) { return u.searchParams.get('ea'); }],
    ['static.klaviyo.com',      'klaviyo',    function () { return null; }],
    ['clarity.ms',              'clarity',    function () { return null; }]
  ];
  // The order id the tag is carrying, under each vendor's own spelling. This is
  // the join that makes the reconciliation exact instead of inferred.
  var TXN_KEYS = ['ep.transaction_id', 'transaction_id', 'cd[order_id]', 'oid', 'ecomm_prodid', 'tid_order'];
  function txnFrom(u) {
    for (var i = 0; i < TXN_KEYS.length; i++) {
      var v = u.searchParams.get(TXN_KEYS[i]);
      if (v) return String(v).slice(0, 64);

        if(!tgt)tgt=document.querySelector('.cart__items,.cart-items,#cart,#main-cart-items,[data-cart-items],.shopping-cart');
      }
      if(tgt&&tgt.parentNode){tgt.parentNode.insertBefore(el,tgt.nextSibling);return el;}
      // Last resort is ABOVE the footer, never the end of <body> - a
      // recommendation nobody reaches is the same as no recommendation.
      var foot=document.querySelector('footer,.footer,#footer,[class*="site-footer"],[class*="Footer"]');
      if(foot&&foot.parentNode){foot.parentNode.insertBefore(el,foot);return el;}
      document.body.appendChild(el);
      return el;
    }
    // Product page: under the buy box (the theme's info column), else right
    // after the product section. Opt-in per store.
    if(recsProductPage()&&RECS_SURF.product&&!recsDrawerVisible()){
      var pf=document.querySelector('form[action*="/cart/add"]');
      var info=pf&&pf.closest&&pf.closest('.product__info-wrapper,.product__info-container,.product-single__meta,.product__details,.product-info,.product__meta');
      if(info){info.appendChild(el);return el;}
      var sec=pf&&pf.closest&&pf.closest('[id^="shopify-section"]');
      if(sec&&sec.parentNode){sec.parentNode.insertBefore(el,sec.nextSibling);return el;}
      return null;
    }
    var drawer=RECS_SURF.drawer?recsDrawerEl():null;
    if(drawer){
      var foot=drawer.querySelector('.drawer__footer,.cart-drawer__footer,[class*="footer"]');
      if(foot&&foot.parentNode)foot.parentNode.insertBefore(el,foot);
      else drawer.appendChild(el);
      return el;
    }

    } catch (_) {}
    try {
      if (window.__tcfapi) window.__tcfapi('addEventListener', 2, function (d, ok) {
        if (!ok || !d) return;
        var before = _consent.tcf_purpose1;
        _consent.tcf_gdpr_applies = d.gdprApplies;
        _consent.tcf_purpose1 = !!(d.purpose && d.purpose.consents && d.purpose.consents[1]);
        if (_consent.tcf_purpose1 !== before) { _consent.source = 'tcf'; postConsent(d.eventStatus || 'tcf'); }
      });
    } catch (_) {}

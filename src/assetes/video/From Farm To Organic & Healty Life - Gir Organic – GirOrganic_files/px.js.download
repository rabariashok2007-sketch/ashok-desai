  }catch(e){cb(null);}}
  function recsCartIds(cb){try{fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(c){
    RECS_SHOP=true;var ids=[];(c&&c.items||[]).forEach(function(it){if(it.product_id)ids.push(String(it.product_id));});
    // Shopify's cart.js totals are in minor units (paise); the API wants major.

      txn_id: txnFrom(u),
      value_minor: u.searchParams.get('ep.value') || u.searchParams.get('cd[value]') || u.searchParams.get('value') || null,
      currency: u.searchParams.get('ep.currency') || u.searchParams.get('cd[currency]') || u.searchParams.get('currency') || null,
      consent: verdict[0], consent_src: verdict[1],

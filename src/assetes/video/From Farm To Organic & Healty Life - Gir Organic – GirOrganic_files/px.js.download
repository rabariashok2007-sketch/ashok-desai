        // Absent when the store has none; never invented.
        var rv=null;for(var i=0;i<items.length;i++){var it=items[i];if(it.review&&it.review.text){rv=it.review;break;}}
        if(!rv&&d.review&&d.review.text)rv=d.review;
        if(rv){
          // Same pastel band the recovery emails use (#f4f7ef / sage accent).
          // Colours are explicit, not inherited - a fixed light background

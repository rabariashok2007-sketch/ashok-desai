          if (c[k] && c[k] !== _consent[k]) { _consent[k] = c[k]; changed = true; }
        });
        if (changed) { _consent.source = 'consent_mode'; postConsent(a[1] || 'update'); }
        return changed;
      };
      if (dl && dl.length) for (var i = 0; i < dl.length; i++) read(dl[i]);
      if (dl && typeof dl.push === 'function') {
        var origPush = dl.push;
        dl.push = function () {
          try { for (var j = 0; j < arguments.length; j++) read(arguments[j]); } catch (_) {}
          return origPush.apply(dl, arguments);
        };

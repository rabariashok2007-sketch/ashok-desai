          h+='<div style="font-size:'+C.pill+';font-weight:600;color:#a6550f;background:#fdf3ea;border-radius:8px;padding:6px 10px;margin-bottom:'+(d.promise?'6px':C.headMb)+'">Add '+recsMoney({price:fs.gap,currency:fs.currency})+' more for free shipping</div>';}
        // The dispatch promise, computed on the server in the store's own
        // time zone from the cutoff the tenant set: a reason to add NOW.
        // A spend-more unlock the store runs in Shopify: same band, the reward named.
        if(d.nudge&&d.nudge.unlock){var ul=d.nudge.unlock;
          h+='<div style="font-size:'+C.pill+';font-weight:600;color:#a6550f;background:#fdf3ea;border-radius:8px;padding:6px 10px;margin-bottom:'+(d.promise?'6px':C.headMb)+'">Add '+recsMoney({price:ul.gap,currency:ul.currency})+' more for '+recsEsc(ul.label)+(ul.code?' · code '+recsEsc(ul.code):'')+'</div>';}
        // The dispatch promise as a band the eye lands on: a clock, the time

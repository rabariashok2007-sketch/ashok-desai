          var cols=st.items.length>1?'1fr 1fr':'1fr';
          var sv=st.offer&&(st.offer.save_amount?('Save '+recsMoney({price:st.offer.save_amount,currency:st.currency})):(st.offer.save_pct?('Save '+st.offer.save_pct+'%'):''));
          var canAddSet=RECS_SHOP&&st.items.every(function(i){return !!i.handle;});
          h+='<div style="'+C.card+'" data-mm-setcard="'+recsEsc(st.id)+'">'

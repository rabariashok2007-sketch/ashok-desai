          var st='';if(rv.rating){var ns=Math.min(5,Math.round(rv.rating));for(var k2=0;k2<ns;k2++)st+='\u2605';}
          h+='<div style="background:#f4f7ef;border-radius:10px;padding:'+C.quotePad+';margin-top:12px;font-size:'+C.quote+';color:#333;line-height:1.5">'
            +(st?'<span style="color:#e8a33d;letter-spacing:1px">'+st+'</span> ':'')
            +'<span style="font-style:italic">\u201C'+recsEsc(rv.text)+'\u201D</span>'
            +(rv.name?'<span style="font-weight:700;color:#555"> \u2014 '+recsEsc(rv.name)+'</span>':'')
            +'</div>';
        }
        h+='</div>';
        host.innerHTML=h;
        host.querySelectorAll('[data-mm-rec]').forEach(function(a){a.addEventListener('click',function(){
          recsLogEvent('click',a.getAttribute('data-mm-rec'));
        });});
        recsTellTruth(host,C);
        // Direct add. A single-variant product goes straight into the cart. A
        // multi-variant product is added at the size the shopper picked in the
        // card itself, so the journey never goes backwards to a product page -
        // and never forwards with a size we chose on their behalf.
        host.querySelectorAll('[data-mm-add]').forEach(function(b){b.addEventListener('click',function(ev2){
          ev2.preventDefault();ev2.stopPropagation();
          var pid=b.getAttribute('data-mm-add'),hd=b.getAttribute('data-mm-h'),url=b.getAttribute('data-mm-url');
          var card=b.closest?b.closest('[data-mm-card]'):null;
          var sel=card?card.querySelector('[data-mm-var]'):null;

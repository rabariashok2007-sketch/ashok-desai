  function recsEsc(s){return String(s||'').replace(/[<>&"]/g,'');}
  function recsStars(p,C){
    // The server decides the policy: proof.rating present = show stars;
    // proof.rating_count present = show the count next to them.
    if(!(p.proof&&p.proof.rating))return '';
    var n=Math.min(5,Math.round(p.proof.rating)),s='';for(var i=0;i<5;i++)s+=(i<n?'\u2605':'\u2606');
    return '<div style="font-size:'+C.star+';margin-top:2px"><span style="color:#e8a33d;letter-spacing:1px">'+s+'</span>'
      +(p.proof.rating_count?' <span style="opacity:.6;font-size:'+C.starSub+'">'+p.proof.rating.toFixed(1)+' ('+p.proof.rating_count+')</span>':'')+'</div>';
  }
  // ONE pill per card. The server already chose the strongest true line for
  // this shopper (pitch); with no pitch the neutral reason label renders in
  // grey - a label, never an invented number. Fixed light pastels with dark
  // text so the pill survives a dark theme's drawer, same as the quote band.
  // ONE line of proof per card. The product's name and the count carry the
  // weight; the lead-in stays quiet. Soft tint, hairline border, no shouting.
  function recsPill(p,C){
    var pt=p.pitch,css,inner;
    if(pt&&pt.text){
      css=(pt.kind==='rel')?'background:#FFF7E8;color:#7A4E12;border:1px solid #F1DDB5':'background:#EDF7F0;color:#1B6B3F;border:1px solid #CDE8D6';
      inner=pt.anchor
        ?'<span style="opacity:.8">'+recsEsc(pt.lead||'Bought with your')+'</span> <b style="font-weight:700">'+recsEsc(pt.anchor)+'</b>'+(pt.count?'<span style="opacity:.45"> · </span><b style="font-weight:700;white-space:nowrap">'+pt.count+'×</b>':'')
        :recsEsc(pt.text);
    }
    else if(p.reason_label){inner=recsEsc(p.reason_label);css='background:#F4F4F2;color:#5A5A56;border:1px solid #E6E6E2';}
    else return '';
    return '<div style="margin-top:8px"><span style="display:inline-block;max-width:100%;padding:5px 10px;border-radius:9px;font-size:'+C.pill+';font-weight:500;line-height:1.4;letter-spacing:.005em;'+css+'">'+inner+'</span></div>';
  }
  // "2h 10m" from minutes; the band re-derives it every minute from the
  // serve-time value so a tab left open does not promise a cutoff that passed.
  function recsLeft(mins){mins=Math.max(0,Math.round(mins));var hh=Math.floor(mins/60),mm=mins%60;return (hh?hh+'h ':'')+mm+'m';}
  try{setInterval(function(){document.querySelectorAll('[data-mm-left]').forEach(function(el){
    var left=Number(el.getAttribute('data-mm-left'))-(Date.now()-Number(el.getAttribute('data-mm-at')))/60000;
    if(left<=0){var band=el.closest&&el.closest('div');if(band){band.innerHTML='<span>The cutoff for same-day dispatch has passed for today · order now and it ships on the next dispatch day</span>';}return;}
    el.textContent=recsLeft(left);});},60000);}catch(e){}
  function recsMoney(p){if(p.price==null)return '';try{return new Intl.NumberFormat(undefined,{style:'currency',currency:p.currency||'USD',maximumFractionDigits:(p.price%1===0?0:2)}).format(p.price);}catch(e){return (p.currency||'')+' '+p.price;}}
  // The tenant's offer on this pick, as the promise the discount will keep:
  // "Add both, save ₹120 · code PAIR10". Only what the tenant entered.
  function recsOffer(p,C){var o=p.offer;if(!o)return '';var s=o.label||((o.type==='pair'?'Add both, save ':'Save ')+(o.save_amount?recsMoney({price:o.save_amount,currency:p.currency}):(o.save_pct?o.save_pct+'%':'')));
    if(!s)return '';return '<div style="display:inline-block;margin-top:5px;font-size:'+C.pill+';font-weight:700;color:#1b7d45;background:#e8f5ec;border-radius:8px;padding:2px 8px">'+recsEsc(s)+(o.code?' · code '+recsEsc(o.code):'')+'</div>';}
  // Button skin. Tenant-set colours win; otherwise sample the theme's OWN
  // add-to-cart (or checkout) button so ours is indistinguishable from the
  // store's - stores want the widget to look native, not like an app. When
  // nothing samples (no button on this page, transparent bg) fall back to a
  // quiet outline that inherits the theme's text colour.
  function recsBtnCss(d){
    var bg=(d.btn&&d.btn.bg)||'',fg=(d.btn&&d.btn.fg)||'',rad='8px';
    if(!bg){try{
      var cand=document.querySelector('form[action*="/cart/add"] [type="submit"],button[name="add"],.product-form__submit,button[name="checkout"],.cart__checkout-button,.button--primary');
      if(cand){var cs=getComputedStyle(cand);var cbg=cs.backgroundColor;
        if(cbg&&cbg!=='transparent'&&cbg.indexOf('rgba(0, 0, 0, 0)')<0){bg=cbg;if(!fg)fg=cs.color;rad=cs.borderRadius||rad;}}
    }catch(e){}}
    if(bg)return 'background:'+bg+';color:'+(fg||'#fff')+';border:0;border-radius:'+rad;
    return 'background:transparent;color:inherit;border:1px solid currentColor;border-radius:8px';
  }
  function recsLogEvent(action,pid){try{fetch(B+'/recs/'+K+'/event',{method:'POST',headers:{'Content-Type':'application/json'},keepalive:true,
    body:JSON.stringify({id:MM,action:action,product_id:pid})});}catch(e){}}
  var recsLast='';
  // Rotate a phone, or drag a desktop window narrow, and the seat beside the
  // totals stops existing - a widget left wedged in a column that is no longer
  // there is worse than one that never used it. Re-decide on resize, and only
  // when the answer actually changes, so a scroll-driven resize on mobile
  // browsers does not rebuild the widget every few pixels.
  var recsRzT=null;
  function recsRemount(){
    var b=document.getElementById(RECS_BOX_ID);if(!b||!recsCartPage())return;
    var p=recsCheckoutParts();
    var want=(p&&p.row&&p.block&&p.free>=RECS_SIDE_MIN)?'side':'stack';
    if(want===recsMode)return;
    if(b.parentNode)b.parentNode.removeChild(b);
    recsLast='';recsRender();
  }
  try{window.addEventListener('resize',function(){clearTimeout(recsRzT);recsRzT=setTimeout(recsRemount,250);});}catch(e){}
  function recsRender(){recsCartIds(function(ids){
    var onProduct=recsProductPage()&&RECS_SURF.product&&RECS_PID;
    var cartEmpty=!ids.length;
    if(onProduct)ids=[RECS_PID].concat(ids.filter(function(x){return x!==RECS_PID;}));
    var sig=ids.join(',');var box=document.getElementById(RECS_BOX_ID);if(sig===recsLast&&box&&box.childNodes.length)return;
    // Resolve the host BEFORE fetching: no surface on this page means no
    // request and no serve row - a serve logged where nothing could ever be
    // seen would quietly corrupt the holdout lift math.
    var host=recsHost();if(!host)return;recsLast=sig;
    fetch(B+'/recs/'+K+'?pids='+encodeURIComponent(sig)+'&id='+encodeURIComponent(MM||'')+'&ctx='+(recsCartPage()?'cart':onProduct?'product':'drawer')+(RECS_TOTAL!=null?'&total='+encodeURIComponent(RECS_TOTAL):''))
      .then(function(r){return r.json();}).then(function(d){
        if(!d||!d.enabled||d.holdout||(!(d.items||[]).length&&!(d.sets||[]).length)){host.innerHTML='';return;}
        var btnCss=recsBtnCss(d);
        // Two layouts for two very different rooms. The cart PAGE has the
        // full width, so it gets the grid at full type scale. The DRAWER's
        // first job is showing the shopper what they just added - a 2x2 grid
        // there buried the cart items below the fold. In the drawer the
        // widget is a single-row swipe strip of compact cards: a third of
        // the height, a half-visible card as the scroll hint, items stay king.
        var inDrawer=!!(host.closest&&host.closest('cart-drawer,#CartDrawer,.cart-drawer,.drawer--cart,#cart-drawer,[id*="CartDrawer"]'));
        var C=inDrawer
          ?{pad:'12px',head:'14px',headMb:'8px',grid:'display:flex;gap:12px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:4px',
            card:'flex:0 0 124px;display:flex;flex-direction:column',title:'12px',price:'12.5px',star:'11px',starSub:'10.5px',pill:'10.5px',
            btnFont:'11.5px',btnPad:'6px 0',quote:'11.5px',quotePad:'8px 12px',imgMax:'',maxW:''}
          // The cart page sits BELOW the checkout block, so it spans the
          // cart's own width like any other section of the page - a 640px box
          // centred under a full-width cart read as a floating island that
          // belonged to nobody. Width is capped per CARD instead: auto-fill
          // clamped to 190px keeps a square image square (no letterbox crop of
          // a tall jar) and bounds the card's height on any cart width, and
          // justify-content:start packs four products left instead of
          // stretching them across a 1450px row.
          :{pad:'18px 20px',head:'16px',headMb:'14px',
            grid:'display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:22px 18px',
            card:'display:flex;flex-direction:column;max-width:300px',title:'14px',price:'14.5px',star:'13px',starSub:'12px',pill:'12px',
            btnFont:'13.5px',btnPad:'9px 0',quote:'13.5px',quotePad:'12px 16px',
            imgMax:'',maxW:''};
        var h='<div style="margin:16px '+(C.maxW?'auto':'0')+';'+(C.maxW?'max-width:'+C.maxW+';':'')+'padding:'+C.pad+';border:1px solid rgba(0,0,0,.08);border-radius:12px;font-family:inherit">'
          // On a product page with nothing in the cart, "your cart" names a
          // cart the shopper does not have: the product-page title is used.
          +'<div style="font-weight:600;font-size:'+C.head+';margin-bottom:'+(d.nudge&&d.nudge.free_shipping?'4px':C.headMb)+'">'+recsEsc((onProduct&&cartEmpty&&d.title_product)?d.title_product:d.title)+'</div>';
        // The free-shipping gap, from the tenant's threshold and this cart's

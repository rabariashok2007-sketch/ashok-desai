  // The Add button renders only when /cart.js answered (a real Shopify
  // storefront) AND the product URL carries a /products/<handle>; otherwise
  // the card stays a plain link, which works on any platform.
  var RECS_BOX_ID='mm-recs';var RECS_SHOP=false;
  var RECS_TOTAL=null;var RECS_SURF={"cart":true,"drawer":true,"product":true};var RECS_PID=null;
  function recsProductPage(){return (/\/products\/[^/?#]+/).test(location.pathname);}
  // The product on a product page: the theme's own analytics meta first, else
  // the handle's JSON. Resolved once at boot.
  function recsProductId(cb){try{
    var m=window.ShopifyAnalytics&&ShopifyAnalytics.meta&&ShopifyAnalytics.meta.product&&ShopifyAnalytics.meta.product.id;
    if(m)return cb(String(m));
    var h=(location.pathname.match(/\/products\/([^/?#]+)/)||[])[1];if(!h)return cb(null);

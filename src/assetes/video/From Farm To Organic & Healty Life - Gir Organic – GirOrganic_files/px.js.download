    function close(host){try{host.remove()}catch(e){}}
    function shell(inner){var host=document.createElement('div');var r=host.attachShadow?host.attachShadow({mode:'open'}):host;
      r.innerHTML='<style>'+css()+'</style><div class="mmpop-back"><div class="mmpop-card"><button class="mmpop-x" aria-label="Close">&times;</button><div class="mmpop-body">'+inner+'</div></div></div>';
      document.body.appendChild(host);
      r.querySelector('.mmpop-x').addEventListener('click',function(){close(host)});
      r.querySelector('.mmpop-back').addEventListener('click',function(e){if(e.target===e.currentTarget)close(host)});
      return {host:host,root:r};}
    function esc(t){return String(t||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]});}
    function show(j){m('mmpop_at');if(j.css)CSS=j.css;
      if(j.show==='coupon'){shell(j.html);return;}
      var c=j.capture||{};
      var ui=shell(j.html);
      var r=ui.root,err=r.querySelector('.mmpop-err');
      r.querySelector('.mmpop-btn').addEventListener('click',function(){
        var em=r.querySelectorAll('.mmpop-in')[0].value.trim(),phv=r.querySelectorAll('.mmpop-in')[1].value.trim(),
            ok=r.querySelector('.mmpop-cons input').checked,btn=this;
        if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)&&phv.replace(/\D/g,'').length<8){err.textContent='Enter a valid email or phone number';err.style.display='block';return;}
        if(!ok){err.textContent='Please tick the consent box';err.style.display='block';return;}
        err.style.display='none';btn.disabled=true;btn.textContent='...';
        fetch(B+'/popup/'+K+'/capture',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({cid:MM,email:em,phone:phv,consent:true,page:location.href})})
          .then(function(x){return x.json()}).then(function(res2){
            if(res2&&res2.ok&&res2.html){r.querySelector('.mmpop-body').innerHTML=res2.html;}
            else{err.textContent=(res2&&res2.error)||'Something went wrong - try again';err.style.display='block';btn.disabled=false;btn.textContent=esc(c.button);}})
          .catch(function(){err.textContent='Network error - try again';err.style.display='block';btn.disabled=false;btn.textContent=esc(c.button);});});}
    function fire(){if(!armed)return;armed=false;
      fetch(B+'/popup/'+K+'?cid='+encodeURIComponent(MM)).then(function(x){return x.json()})
        .then(function(j){if(j&&j.show&&eligible(j.suppress_days))show(j);})
        .catch(function(){});}

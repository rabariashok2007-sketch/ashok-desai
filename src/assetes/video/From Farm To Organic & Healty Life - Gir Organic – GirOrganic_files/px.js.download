}

/**
 * A MONITOR THAT CANNOT START MUST SAY SO.
 *
 * Both hosts used to wrap MM_OBSERVER in `try {} catch (_) {}`. That is right
 * about one thing - the monitor must never take the beacon down with it - and
 * wrong about the other: a monitor that silently never runs is
 * indistinguishable from a store whose tags never fire. So the failure is
 * caught, and then told three ways:
 *
 *   - the browser console, for whoever is looking at the page
 *   - window.__MM_OBSERVER_STATE__, for a support check or a test
 *   - one row back to us (vendor '_observer', status 'error', the message in
 *     `detail`), once per session, so the dashboard can say "the monitor is
 *     on but failed to start on 14 pages: <reason>" instead of "no tags yet"
 *
 * The report rides the same /tags/ intake as every fire, because a new public
 * path has to be added to the nginx allowlist for every transport and a
 * missing one 404s silently - the exact failure this exists to end.
 */
function MM_OBSERVER_FAILED(H, err) {
  var msg = 'unknown error';
  try { msg = String((err && (err.message || err)) || msg).slice(0, 300); } catch (_) {}
  try { window.__MM_OBSERVER_STATE__ = { started: false, error: msg }; } catch (_) {}
  try { if (window.console && console.warn) console.warn('[cookiebees] the tag monitor did not start: ' + msg); } catch (_) {}
  try {
    if (!H || !H.key || !H.base || typeof H.send !== 'function') return;
    try {
      if (sessionStorage.getItem('mm_obs_err') === msg) return;
      sessionStorage.setItem('mm_obs_err', msg);
    } catch (_) {}
    var id = null, sid = null;
    try { id = typeof H.id === 'function' ? H.id() : null; } catch (_) {}
    try { sid = typeof H.sid === 'function' ? H.sid() : null; } catch (_) {}
    H.send(H.base + '/tags/' + encodeURIComponent(H.key), JSON.stringify({
      mm_id: id, session_id: sid, fires: [],
      observer_error: { message: msg, page_path: location.pathname }
    }));
  } catch (_) {}
}

  // A failure to start is caught (the beacon must survive it) and reported
  // (console, window.__MM_OBSERVER_STATE__, one row per session) rather than
  // swallowed: a monitor that silently never runs reads as "no tags fired".
  var OBS_H={key:K,base:T,id:function(){return MM;},sid:sid,
    send:function(u,b){try{if(navigator.sendBeacon){navigator.sendBeacon(u,new Blob([b],{type:'text/plain'}));return;}}catch(e){}
      try{fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},keepalive:true,body:b});}catch(e){}}};
  try{MM_OBSERVER(OBS_H);}catch(e){MM_OBSERVER_FAILED(OBS_H,e);}

})();
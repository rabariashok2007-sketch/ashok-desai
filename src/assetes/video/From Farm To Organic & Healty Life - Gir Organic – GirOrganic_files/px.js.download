  // Refresh when the cart changes: same AJAX seams the attribute writer uses,
  // hooked independently so recs works even where cart_attr is off. Our own
  // /cart/add.js from the Add button flows through this too - the widget
  // re-renders with the new item as an anchor.
  try{var _rf=window.fetch;window.fetch=function(u){var pr=_rf.apply(this,arguments);
    try{var su=(typeof u==='string')?u:((u&&u.url)||'');
      if(/\/cart\/(add|change|clear|update)(\.js)?/.test(su)&&!/mm-recs/.test(su))pr.then(function(){setTimeout(recsRender,350);setTimeout(recsRender,1400);},function(){});}catch(e){}
    return pr;};}catch(e){}
  // The drawer renders when it OPENS, not only when the cart changes. Clicking

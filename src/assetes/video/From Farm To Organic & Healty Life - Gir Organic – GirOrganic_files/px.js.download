          var canAddR=RECS_SHOP&&rp.handle;
          h+='<div style="display:flex;align-items:center;gap:12px;border:1px solid #F1DDB5;background:#FFF9EE;border-radius:12px;padding:10px 12px;margin-bottom:'+C.headMb+'">'
            +(rp.image?'<a href="'+(rp.url||'#')+'" data-mm-rec="'+rp.id+'" style="flex:0 0 auto"><img src="'+rp.image+'" alt="" loading="lazy" style="width:56px;height:56px;object-fit:cover;border-radius:9px;display:block"></a>':'')
            +'<div style="flex:1 1 auto;min-width:0">'
              +'<div style="font-size:'+C.pill+';font-weight:700;color:#7A4E12;text-transform:uppercase;letter-spacing:.06em">Running low?</div>'
              +'<div style="font-size:'+C.title+';font-weight:600;line-height:1.3;margin-top:2px">'+recsEsc(rp.title)+'</div>'
              +'<div style="font-size:'+C.pill+';color:#5A5A56;margin-top:2px">You bought it <b style="color:#111">'+ro.days_since+' days ago</b> · '+recsEsc(when)+(rp.price!=null?' · '+recsMoney(rp):'')+'</div>'
            +'</div>'
            +(canAddR?'<button type="button" data-mm-add="'+rp.id+'" data-mm-h="'+recsEsc(rp.handle)+'" data-mm-url="'+(rp.url||'#')+'" data-mm-code="'+recsEsc(rp.offer&&rp.offer.code||'')+'"'
              +' style="flex:0 0 auto;padding:'+C.btnPad+' ;padding-left:16px;padding-right:16px;'+btnCss+';font-family:inherit;font-size:'+C.btnFont+';font-weight:600;cursor:pointer;white-space:nowrap">Reorder</button>':'')
          +'</div>';}
        // Never a card alone on a second row. Whatever the container - the

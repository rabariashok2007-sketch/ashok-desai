  // denominator has to be complete or "812 of 1,844" is a guess. Everything
  // else rides a sample, because tag inventory and drift do not need census.
  var ALWAYS = /^(purchase|Purchase|CompletePayment|conversion|begin_checkout|InitiateCheckout|add_to_cart|AddToCart)$/;
  var SAMPLE_RATE = 0.05;
  var _sampled = null;
  function inSample() {
    if (_sampled === null) {
      try {
        var k = sessionStorage.getItem('mm_obs');

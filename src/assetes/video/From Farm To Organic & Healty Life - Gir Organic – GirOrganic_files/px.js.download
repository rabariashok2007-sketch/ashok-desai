            sel.style.borderColor='#c0392b';
            try{sel.focus();}catch(e){}
            return;
          }
          b.disabled=true;var t0=b.textContent;b.textContent='Adding\u2026';
          recsProduct(hd).then(function(prod){
            // AVAILABLE variants, not total. The test was variants.length!==1,
            // so a product with four sizes of which three are sold out went to
            // its own page instead of adding the only one anybody could buy.
            // On this store 4 of 5 products carry several sizes, so almost
            // every "Add to cart" navigated away instead of adding - which is
            // the bug as reported.
            var vs=recsBuyable(prod);
            var v=null;
            if(sel&&sel.value){for(var vi=0;vi<vs.length;vi++)if(String(vs[vi].id)===String(sel.value))v=vs[vi];}
            if(!v&&vs.length===1)v=vs[0];
            // No picker rendered yet and more than one thing to choose from -
            // the only honest move left is the product page.
            if(!v){location.href=url;return null;}
            return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',
              body:JSON.stringify({id:v.id,quantity:1})}).then(function(r2){
                if(!r2.ok)throw 0;
                b.textContent='Added \u2713';
                recsLogEvent('add_to_cart',pid);
                // The offer's code, applied the way Shopify applies a shared
                // discount link: /discount/CODE sets the checkout cookie.
                var code=b.getAttribute('data-mm-code');
                if(code){try{fetch('/discount/'+encodeURIComponent(code),{credentials:'same-origin'}).catch(function(){});}catch(e){}}
                // The theme's own cart UI (item list, header count, drawer)
                // was bypassed, so a reload is the only theme-agnostic way to
                // show true state. The event log uses keepalive and survives it.
                try{document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));}catch(e){}
                setTimeout(function(){location.reload();},450);
              });
          }).catch(function(){b.disabled=false;b.textContent=t0;location.href=url;});
        });});
        // The set: every missing item must be single-variant, then ONE
        // /cart/add.js call with all of them; otherwise open the first product.
        host.querySelectorAll('[data-mm-addset]').forEach(function(b){b.addEventListener('click',function(ev2){
          ev2.preventDefault();ev2.stopPropagation();
          var hs=b.getAttribute('data-mm-addset').split(','),url=b.getAttribute('data-mm-url');
          b.disabled=true;var t0=b.textContent;b.textContent='Adding…';
          Promise.all(hs.map(function(hd){return recsProduct(hd);})).then(function(prods){
            var items=[];for(var i=0;i<prods.length;i++){var vs=recsBuyable(prods[i]);if(vs.length!==1){location.href=url;return null;}items.push({id:vs[0].id,quantity:1});}
            return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({items:items})}).then(function(r2){
              if(!r2.ok)throw 0;
              b.textContent='Added ✓';
              hs.forEach(function(hd,i){recsLogEvent('add_to_cart',String(prods[i]&&prods[i].id||hd));});
              var code=b.getAttribute('data-mm-code');
              if(code){try{fetch('/discount/'+encodeURIComponent(code),{credentials:'same-origin'}).catch(function(){});}catch(e){}}
              setTimeout(function(){location.reload();},450);
            });
          }).catch(function(){b.disabled=false;b.textContent=t0;location.href=url;});
        });});
      }).catch(function(){});

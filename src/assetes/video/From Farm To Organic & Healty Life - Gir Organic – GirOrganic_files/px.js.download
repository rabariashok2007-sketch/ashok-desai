          var prCss=pr.today?'background:#EDF7F0;color:#1B6B3F;border:1px solid #CDE8D6':'background:#F4F4F2;color:#3F3F3B;border:1px solid #E6E6E2';
          var clock='<svg viewBox="0 0 24 24" width="15" height="15" style="flex:0 0 auto;margin-right:8px" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
          var prBody=pr.today
            ?'Order in <b data-mm-left="'+(pr.minutes_left||0)+'" data-mm-at="'+Date.now()+'" style="font-weight:700">'+recsEsc(recsLeft(pr.minutes_left||0))+'</b> and it ships <b style="font-weight:700">today</b><span style="opacity:.65"> · cutoff '+recsEsc(pr.cutoff_label||'')+'</span>'
            :'Order now and it ships <b style="font-weight:700">'+recsEsc(pr.next_day||pr.ships||'')+'</b>'+(pr.cutoff_label?'<span style="opacity:.65"> · orders before '+recsEsc(pr.cutoff_label)+' leave the same day</span>':'');
          h+='<div style="display:flex;align-items:center;font-size:'+C.pill+';border-radius:9px;padding:7px 11px;margin-bottom:'+C.headMb+';'+prCss+'">'+clock+'<span>'+prBody+'</span></div>';}
        // The reorder pick is not one card among four: it is the shopper's own

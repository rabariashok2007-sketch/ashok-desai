    if (_consent.ad_storage === 'denied' || _consent.analytics_storage === 'denied') return ['denied', 'consent_mode'];
    if (_consent.ad_storage === 'granted' || _consent.analytics_storage === 'granted') return ['granted', 'consent_mode'];
    if (_consent.tcf_purpose1 === true) return ['granted', 'tcf'];
    if (_consent.tcf_gdpr_applies === true && _consent.tcf_purpose1 === false) return ['denied', 'tcf'];
    return ['unknown', 'none'];
  }
  function postConsent(reason) {
    var body = JSON.stringify({
      mm_id: H.id(), session_id: H.sid(), page_path: location.pathname,
      source: _consent.source, reason: reason || _consent.reason,
      ad_storage: _consent.ad_storage || null, analytics_storage: _consent.analytics_storage || null,
      ad_user_data: _consent.ad_user_data || null, ad_personalization: _consent.ad_personalization || null,
      gpc: _consent.gpc === undefined ? null : !!_consent.gpc,
      tcf_gdpr_applies: _consent.tcf_gdpr_applies === undefined ? null : !!_consent.tcf_gdpr_applies,
      tcf_purpose1: _consent.tcf_purpose1 === undefined ? null : !!_consent.tcf_purpose1,

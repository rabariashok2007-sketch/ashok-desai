  try{if(recsProductPage()&&RECS_SURF.product)recsProductId(function(id){RECS_PID=id;if(id)setTimeout(recsRender,300);});}catch(e){}
  try{recsWatchDrawer();}catch(e){}
  // ── recovery popup ──────────────────────────────────────────────────────
  // Dormant until: cart activity this session + an exit signal + not shown
  // recently + no recent purchase. One GET decides which face shows; a store
  // with the popup disabled pays one fetch per triggered session, nothing per
  // pageview. Never on checkout (Shopify locks it anyway).
  (function(){
    if(/\/(checkouts?|checkout)\b/.test(location.pathname))return;
    function g(k){try{return Number(localStorage.getItem(k)||0)}catch(e){return 0}}
    function m(k){try{localStorage.setItem(k,String(Date.now()))}catch(e){}}
    var armed=true;
    function eligible(sd){var now=Date.now();
      if(!g('mmpop_cart')||now-g('mmpop_cart')>21600000)return false;      // basket in last 6h
      if(g('mmpop_done')&&now-g('mmpop_done')<2592000000)return false;      // bought in last 30d
      if(g('mmpop_at')&&now-g('mmpop_at')<(sd||3)*86400000)return false;    // shown recently
      return true;}

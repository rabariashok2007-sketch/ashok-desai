            +'<div style="font-size:'+C.title+';font-weight:600;margin-top:6px;line-height:1.35">'+recsEsc(st.label)+'</div>'
            +'<div style="font-size:'+C.pill+';color:#555;margin-top:2px">You have '+st.in_cart+' of '+st.size+' · add the rest for '+recsMoney({price:st.missing_total,currency:st.currency})+'</div>'
            +(sv?'<div style="display:inline-block;margin-top:5px;font-size:'+C.pill+';font-weight:700;color:#1b7d45;background:#e8f5ec;border-radius:8px;padding:2px 8px">'+recsEsc(sv)+(st.offer.code?' · code '+recsEsc(st.offer.code):'')+'</div>':'')
            +(canAddSet?'<button type="button" data-mm-addset="'+recsEsc(st.items.map(function(i){return i.handle;}).join(','))+'" data-mm-url="'+(st.items[0].url||'#')+'" data-mm-code="'+recsEsc(st.offer&&st.offer.code||'')+'"'
              +' style="margin-top:7px;width:100%;padding:'+C.btnPad+';'+btnCss+';font-family:inherit;font-size:'+C.btnFont+';font-weight:600;cursor:pointer">Add the set</button>':'')
            +'</div>';
        });
        items.forEach(function(p){
          var canAdd=RECS_SHOP&&p.handle;
          h+='<div data-mm-card="'+p.id+'" data-mm-cur="'+recsEsc(p.currency||'')+'" style="'+C.card+'">'
            +'<a href="'+(p.url||'#')+'" data-mm-rec="'+p.id+'" style="text-decoration:none;color:inherit;display:block;flex:1">'
            +(p.image?'<img src="'+p.image+'" alt="" loading="lazy" style="width:100%;aspect-ratio:1;'+(C.imgMax?'max-height:'+C.imgMax+';':'')+'object-fit:cover;border-radius:12px;background:#F6F6F3;display:block">':'')
            +'<div style="font-size:'+C.title+';font-weight:600;margin-top:10px;line-height:1.3;letter-spacing:-.005em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">'+recsEsc(p.title)+'</div>'
            +recsStars(p,C)
            +'<div data-mm-price="1" style="font-size:'+C.price+';font-weight:700;margin-top:4px;letter-spacing:-.01em">'+recsMoney(p)+'</div>'
            +recsPill(p,C)
            +recsOffer(p,C)
            +'</a>'
            +(canAdd?'<button type="button" data-mm-add="'+p.id+'" data-mm-h="'+recsEsc(p.handle)+'" data-mm-url="'+(p.url||'#')+'" data-mm-code="'+recsEsc(p.offer&&p.offer.code||'')+'"'
              +' style="margin-top:9px;width:100%;padding:'+C.btnPad+';'+btnCss+';font-family:inherit;font-size:'+C.btnFont+';font-weight:600;letter-spacing:.01em;cursor:pointer;transition:transform .12s ease,box-shadow .12s ease">Add to cart</button>':'')
            +'</div>';
        });
        h+='</div>';
        // One real customer's words under the grid - a review on a shown
